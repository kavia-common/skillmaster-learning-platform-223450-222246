# PUBLIC_INTERFACE
# Frontend environment example for local development

# Preferred backend base URL (FastAPI)
REACT_APP_API_BASE=http://localhost:3001

# Legacy/alternate name supported by our config loader
# REACT_APP_BACKEND_URL=http://localhost:3001

# Frontend origin (for backend CORS reference; not read by code)
REACT_APP_FRONTEND_URL=http://localhost:3000

# Optional WebSocket URL if used later
# REACT_APP_WS_URL=

# Log level for API client: error|warn|info|debug
REACT_APP_LOG_LEVEL=info

# Healthcheck path used inside the app
REACT_APP_HEALTHCHECK_PATH=/healthz

# Feature flags: JSON or comma-separated (flagA,flagB:1)
# REACT_APP_FEATURE_FLAGS={"newCatalog":true}

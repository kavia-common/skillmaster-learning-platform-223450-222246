# Frontend environment variables (Copy to .env and adjust for your environment)
# NOTE: Do not commit actual secrets here. These variables are public at build time for CRA apps.

# Backend base URL (preferred)
REACT_APP_API_BASE=http://localhost:3001
# Alternate variable supported for compatibility
REACT_APP_BACKEND_URL=http://localhost:3001

# Frontend base URL
REACT_APP_FRONTEND_URL=http://localhost:3000

# Optional WebSocket URL
REACT_APP_WS_URL=

# Logging level: error | warn | info | debug
REACT_APP_LOG_LEVEL=warn

# Healthcheck path
REACT_APP_HEALTHCHECK_PATH=/healthz

# Feature flags: JSON or comma-separated list
# Examples:
#   REACT_APP_FEATURE_FLAGS={"newUI":true,"betaLesson":false}
#   REACT_APP_FEATURE_FLAGS=newUI,betaLesson=false
REACT_APP_FEATURE_FLAGS=

# Other typical toggles
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=true
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_TRUST_PROXY=false
REACT_APP_PORT=3000
REACT_APP_EXPERIMENTS_ENABLED=false

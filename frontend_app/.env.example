# Frontend environment variables (copy to .env and adjust)
# Preferred base URL of backend (FastAPI). Example: http://localhost:3001
REACT_APP_API_BASE=http://localhost:3001

# Legacy/alternate base URL (if API_BASE not set)
# REACT_APP_BACKEND_URL=http://localhost:3001

# Optional: where the frontend is hosted (used for docs/links only)
REACT_APP_FRONTEND_URL=http://localhost:3000

# Optional: WebSocket URL if used in future
# REACT_APP_WS_URL=ws://localhost:3001

# Optional: Feature flags (JSON or comma-separated)
# REACT_APP_FEATURE_FLAGS={"newCatalog":true}

# Optional: Log level: error|warn|info|debug
REACT_APP_LOG_LEVEL=warn

# Optional: Healthcheck path for diagnostics
REACT_APP_HEALTHCHECK_PATH=/healthz

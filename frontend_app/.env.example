# PUBLIC_INTERFACE
# Frontend environment variables (copy to .env and adjust as needed)
# Use these to configure backend base URLs and client behavior.

# Preferred backend base URL (FastAPI)
REACT_APP_API_BASE=http://localhost:3001

# Legacy/alternate key if needed
# REACT_APP_BACKEND_URL=http://localhost:3001

# Frontend absolute URL (used for links/redirects in some features)
REACT_APP_FRONTEND_URL=http://localhost:3000

# Optional WebSocket base (not required for this task)
# REACT_APP_WS_URL=

# Node env override
REACT_APP_NODE_ENV=development

# Logging level for api client: error|warn|info|debug
REACT_APP_LOG_LEVEL=warn

# Feature flags (JSON or comma-separated: flagA,flagB:1)
# REACT_APP_FEATURE_FLAGS={"newSkillsProgress":true}

# Health check path
REACT_APP_HEALTHCHECK_PATH=/healthz

# Build/test tweaks
REACT_APP_NEXT_TELEMETRY_DISABLED=1
REACT_APP_ENABLE_SOURCE_MAPS=1
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=0

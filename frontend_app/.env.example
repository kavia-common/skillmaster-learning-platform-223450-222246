# Frontend environment variables (public)
# Copy to .env and adjust as needed (do NOT commit .env with secrets).

# Backend API base URL (FastAPI). Defaults to http://localhost:3001 if unset.
REACT_APP_API_BASE=http://localhost:3001

# Optional alternate variable name supported by config/env.js
# REACT_APP_BACKEND_URL=http://localhost:3001

# Frontend site URL (used by some flows; optional)
# REACT_APP_FRONTEND_URL=http://localhost:3000

# Console log level: error|warn|info|debug
REACT_APP_LOG_LEVEL=info

# Feature flags: JSON or comma-separated (e.g., "newUI:1,enableX")
# REACT_APP_FEATURE_FLAGS={"newUI":true}

# Healthcheck path used by some components
# REACT_APP_HEALTHCHECK_PATH=/healthz

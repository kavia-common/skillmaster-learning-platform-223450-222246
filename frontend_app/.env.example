# Frontend environment variables for SkillMaster (React)
# Copy this file to .env and adjust as needed.

# Preferred base URL for the backend (FastAPI). Example for local dev:
REACT_APP_API_BASE=http://localhost:3001

# Legacy/alternate key. Used if REACT_APP_API_BASE is not set.
REACT_APP_BACKEND_URL=http://localhost:3001

# Optional public frontend URL (used in links/redirects)
REACT_APP_FRONTEND_URL=http://localhost:3000

# Logging level for API client: error | warn | info | debug
REACT_APP_LOG_LEVEL=info

# Feature flags: either JSON or comma-separated values
# Examples:
# REACT_APP_FEATURE_FLAGS={"newCatalog":true,"betaUI":false}
# REACT_APP_FEATURE_FLAGS=newCatalog,betaUI:0
# REACT_APP_FEATURE_FLAGS=

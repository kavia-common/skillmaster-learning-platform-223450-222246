# Frontend environment example for local development
# Copy to .env and adjust values as needed.

# PUBLIC_ENDPOINTS
REACT_APP_API_BASE=http://localhost:3001
REACT_APP_BACKEND_URL=http://localhost:3001
REACT_APP_FRONTEND_URL=http://localhost:3000

# Optional websocket base
REACT_APP_WS_URL=

# Node environment
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=1
REACT_APP_ENABLE_SOURCE_MAPS=true

# Frontend runtime options
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=false
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/healthz

# Feature flags (JSON or comma-separated)
# Example JSON: {"newPlayer":true,"betaCatalog":false}
# Example CSV: newPlayer:true,betaCatalog:false
REACT_APP_FEATURE_FLAGS={"betaCatalog":true}

# Notes:
# - Ensure backend FastAPI is running on :3001 and allows CORS for http://localhost:3000 with allow_credentials=true.
# - Seed backend data: PYTHONPATH=backend python3 -m src.seeds.run_all_seeds
# - Quick backend help page: http://localhost:3001/__backend_help

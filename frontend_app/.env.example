# Frontend environment variables for local development

# Preferred base URL to the backend FastAPI (with NO trailing slash)
REACT_APP_API_BASE=http://localhost:3001

# Legacy override (used only if API_BASE not set)
REACT_APP_BACKEND_URL=

# Frontend public origin (used for docs/help; CRA serves on :3000 by default)
REACT_APP_FRONTEND_URL=http://localhost:3000

# Optional WebSocket URL (not currently used)
REACT_APP_WS_URL=

# Node environment
REACT_APP_NODE_ENV=development

# Logging verbosity for api client: error | warn | info | debug
REACT_APP_LOG_LEVEL=info

# Feature flags - can be JSON or comma-separated (e.g., newUI:true,expA,onboarding)
REACT_APP_FEATURE_FLAGS={}

# Healthcheck path for any probes
REACT_APP_HEALTHCHECK_PATH=/healthz

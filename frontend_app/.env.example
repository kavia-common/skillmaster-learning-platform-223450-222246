# Frontend environment variables
# Base URL to backend API (FastAPI). If not set, app will fallback to origin with 3000->3001 swap locally.
REACT_APP_BACKEND_URL=http://localhost:3001
# Alternative base var supported by clients
REACT_APP_API_BASE=
# Optional logging level: error|warn|info|debug
REACT_APP_LOG_LEVEL=warn
# Optional feature flags: JSON or comma separated (flagA=true,flagB)
REACT_APP_FEATURE_FLAGS=

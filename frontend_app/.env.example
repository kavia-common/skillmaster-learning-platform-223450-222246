# Frontend environment example for SkillMaster
# Copy this file to ".env" and adjust values per environment.

# Backend base URL (prefer this). Example for local dev backend on port 3001:
REACT_APP_API_BASE=http://localhost:3001

# Alternate legacy name (used if API_BASE not set)
REACT_APP_BACKEND_URL=

# Frontend public URL (optional; defaults to window.location.origin)
REACT_APP_FRONTEND_URL=http://localhost:3000

# WebSocket base URL (optional)
REACT_APP_WS_URL=

# Node environment override (optional)
REACT_APP_NODE_ENV=development

# Logging level: error | warn | info | debug
REACT_APP_LOG_LEVEL=warn

# Feature flags (JSON or comma-separated list, e.g. "newNav:true,expQuiz")
REACT_APP_FEATURE_FLAGS=

# Healthcheck path (optional)
REACT_APP_HEALTHCHECK_PATH=/healthz

# Other optional tunables
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=false
REACT_APP_EXPERIMENTS_ENABLED=false
